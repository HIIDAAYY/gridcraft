<?xml version="1.0" encoding="utf-8"?>
<!-- GridCraft for Android. build-apk.sh fills in the package and version. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="gridcraft.android">

    <!-- wgpu draws with Vulkan where the device has it, OpenGL ES 3 otherwise. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Links in cells open in the browser or mail app (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:label="GridCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="true"
        android:resizeableActivity="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- One window: a workbook opened from another app arrives in the running app.
             Rotating, resizing or a keyboard coming and going never restarts it. -->
        <activity
            android:name="gridcraft.android.GridCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale">
            <meta-data android:name="android.app.lib_name" android:value="gridcraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open with GridCraft: Excel, OpenDocument and text spreadsheets. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroEnabled.12" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-excel.sheet.binary.macroEnabled.12" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
            </intent-filter>

            <!-- Share a workbook to GridCraft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
        </activity>
    </application>
</manifest>
